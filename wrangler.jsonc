// Cloudflare Workers (static assets) deployment config.
// The dashboard git integration reads this — no preset/output-directory
// fields needed in the UI.
{
  "name": "kimnco",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    // Serve dist/ko/portfolio/index.html at /ko/portfolio (no trailing slash),
    // matching the canonical URLs, hreflang and sitemap. The default
    // (auto-trailing-slash) 307-redirects /ko/portfolio -> /ko/portfolio/.
    "html_handling": "drop-trailing-slash",
    // Unknown routes serve index.html with 200 (SPA fallback),
    // same behavior as Cloudflare Pages / our previous Vercel rewrite.
    "not_found_handling": "single-page-application"
  }
}
